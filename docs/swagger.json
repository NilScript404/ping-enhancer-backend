{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/configs": {
            "get": {
                "description": "Fetches available server endpoints, user traffic/expiration info, and raw WireGuard configurations",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "configs"
                ],
                "summary": "Get WireGuard Configurations",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.ConfigDTO"
                            }
                        }
                    }
                }
            }
        },
        "/api/games": {
            "get": {
                "description": "Retrieves a list of all supported games and their executable process names",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Get all games",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.GameDTO"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Adds a new game and its target process name to the database",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Create a new game",
                "parameters": [
                    {
                        "description": "Game payload",
                        "name": "game",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.GameDTO"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/api.GameDTO"
                        }
                    }
                }
            }
        },
        "/api/games/{name}": {
            "put": {
                "description": "Updates a game's name or process name by its current name",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Update an existing game",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Current Game Name (URL encoded)",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Updated game fields",
                        "name": "game",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.GameDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.GameDTO"
                        }
                    }
                }
            },
            "delete": {
                "description": "Removes a game from the database by its name",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Delete a game",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Game Name (URL encoded)",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        }
    },
    "definitions": {
        "api.ConfigDTO": {
            "type": "object",
            "properties": {
                "bytes_total": {
                    "type": "integer",
                    "example": 53687091200
                },
                "bytes_used": {
                    "type": "integer",
                    "example": 1073741824
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "location": {
                    "type": "string",
                    "example": "DE"
                },
                "name": {
                    "type": "string",
                    "example": "Germany 01"
                },
                "remaining_days": {
                    "type": "integer",
                    "example": 14
                },
                "route_address": {
                    "type": "string",
                    "example": "DE.DOMAIN.IR"
                },
                "route_type": {
                    "type": "string",
                    "example": "relay"
                },
                "value": {
                    "type": "string",
                    "example": "[Interface]\nPrivateKey = ..."
                }
            }
        },
        "api.GameDTO": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "Apex Legends"
                },
                "process_name": {
                    "type": "string",
                    "example": "r5apex.exe"
                }
            }
        }
    }
}